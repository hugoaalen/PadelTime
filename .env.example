DATABASE_URL=sqlite:///./padeltime.db
DEMO_MODE=true
VITE_API_URL=/api
# Production: postgresql+psycopg://user:password@localhost/padeltime
# Optional real public-web snapshot (never mixed with mock data)
# DATA_PROVIDER=snapshot
# SNAPSHOT_PATH=/absolute/path/to/PadelTime/data/premier.json
# Opt-in single-process background collection while API runs:
# COLLECTOR_ENABLED=true
# COLLECTOR_SLUG=milano-p1-2
# COLLECTOR_INTERVAL=90
# ORDER_FILE=/absolute/path/to/reviewed-order.json
# Zero-budget serverless deployment: Firebase SPARK ONLY (no billing account).
# FIREBASE_PLAN=spark
# FIREBASE_SERVICE_ACCOUNT=<private JSON stored ONLY as encrypted Vercel environment variable>
# COLLECT_SECRET=<random secret of at least 32 characters, also stored in free clock worker>
# Never commit the private service account or COLLECT_SECRET.
