# Local demo / snapshot API (no Firebase account needed):
VITE_API_URL=/api
VITE_CLOUD_MODE=false
# Set true ONLY on Vercel with a configured Firebase Spark backend.
# Public web configuration from your own Firebase console (not a private key):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
